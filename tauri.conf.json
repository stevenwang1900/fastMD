{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fastMD",
  "version": "0.1.0",
  "identifier": "com.mywiki.fastmd",
  "build": {
    "frontendDist": "index.html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "fastMD",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "entitlements": null
    }
  }
}
